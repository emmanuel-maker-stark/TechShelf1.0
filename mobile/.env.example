# Clerk publishable key is public and is safe to bundle into the Android app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_Clerk_publishable_key

# Required for Clerk's native Google sign-in flow. Configure matching OAuth clients in Google Cloud and Clerk.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=replace_with_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=replace_with_android_client_id.apps.googleusercontent.com

# Convex deployment URL. Set separately from any Convex server-side secrets.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
